# Repton 3 (Superior Software, 1986), the menu/splash font.
#
# The soft font the MOS holds at &C00: VDU 23 redefinitions of characters
# 224-249 as a chunky A-Z, so the game prints a capital by printing
# character letter+159 (A=&E0=224 ... Z=&F9=249). Read straight from that RAM,
# the mapping being exact -- code 224+n is the nth letter.
#
# The screen-text library reads the ROM font, so it declines these and the
# menu text (PLEASE SELECT / THE GAME / THE EDITOR) copies as spaces, while the
# ROM-font parentheses and digits of "(1)" and "(2)" read. Supply this set and
# the menu reads in full.
#
# Note this is only Repton's MENU font. Its credits screen ("Written by
# Matthew Atkinson...") uses a different, thinner font the game blits from its
# own table -- not in &C00, not the ROM -- the way Thrust does throughout. So
# one game uses both mechanisms, a screen each.
#
# codepoint, then one byte per row.

0x0041 0x3C 0x7E 0x0E 0x7E 0x66 0x66 0x66 0x00  # &E0 = 'A'
0x0042 0x7C 0x06 0x7E 0x7C 0x7E 0x06 0x7C 0x00  # &E1 = 'B'
0x0043 0x3C 0x7E 0x60 0x60 0x7C 0x7E 0x3C 0x00  # &E2 = 'C'
0x0044 0x78 0x7C 0x0E 0x7E 0x7E 0x7C 0x78 0x00  # &E3 = 'D'
0x0045 0x78 0x60 0x60 0x7C 0x60 0x60 0x7E 0x00  # &E4 = 'E'
0x0046 0x7E 0x7E 0x60 0x7C 0x7C 0x60 0x60 0x00  # &E5 = 'F'
0x0047 0x3C 0x7E 0x60 0x6E 0x6E 0x6E 0x3C 0x00  # &E6 = 'G'
0x0048 0x66 0x66 0x7E 0x7E 0x66 0x66 0x66 0x00  # &E7 = 'H'
0x0049 0x7E 0x7E 0x18 0x18 0x18 0x7E 0x7E 0x00  # &E8 = 'I'
0x004A 0x3E 0x3E 0x0C 0x0C 0x0C 0x6C 0x7C 0x00  # &E9 = 'J'
0x004B 0x7E 0x7C 0x78 0x70 0x78 0x7C 0x7E 0x00  # &EA = 'K'
0x004C 0x60 0x60 0x60 0x60 0x60 0x7E 0x7E 0x00  # &EB = 'L'
0x004D 0x63 0x77 0x7F 0x7F 0x77 0x77 0x77 0x00  # &EC = 'M'
0x004E 0x66 0x76 0x7E 0x7E 0x7E 0x6E 0x6E 0x00  # &ED = 'N'
0x004F 0x3C 0x7E 0x7E 0x7E 0x7E 0x7E 0x3C 0x00  # &EE = 'O'
0x0050 0x7C 0x0E 0x7E 0x7C 0x60 0x60 0x60 0x00  # &EF = 'P'
0x0051 0x3C 0x76 0x76 0x76 0x76 0x7A 0x3C 0x00  # &F0 = 'Q'
0x0052 0x7C 0x0E 0x7E 0x7C 0x6C 0x66 0x66 0x00  # &F1 = 'R'
0x0053 0x3C 0x7E 0x60 0x3C 0x06 0x7E 0x3C 0x00  # &F2 = 'S'
0x0054 0x7E 0x7E 0x18 0x18 0x18 0x18 0x18 0x00  # &F3 = 'T'
0x0055 0x66 0x66 0x66 0x66 0x7E 0x7E 0x3C 0x00  # &F4 = 'U'
0x0056 0x66 0x66 0x66 0x66 0x66 0x3C 0x18 0x00  # &F5 = 'V'
0x0057 0x5D 0x5D 0x5D 0x7F 0x7F 0x77 0x63 0x00  # &F6 = 'W'
0x0058 0x7E 0x7E 0x3C 0x18 0x3C 0x7E 0x7E 0x00  # &F7 = 'X'
0x0059 0x6E 0x6E 0x6E 0x3C 0x18 0x18 0x18 0x00  # &F8 = 'Y'
0x005A 0x7E 0x7E 0x0C 0x18 0x30 0x7E 0x7E 0x00  # &F9 = 'Z'

# Thrust (Superior Software, 1986), the high-score font.
#
# Not a BBC ROM font and not a VDU 23 redefinition: a bespoke 5-pixel-tall
# typeface the game blits from its own glyph table, so the MOS never assigns
# these glyphs a character code. The screen-text library reads the ROM font,
# so on thrust-hiscore.png it declines this font entirely and the text copies
# as spaces -- correctly, never guessed. Supply this set and it reads.
#
# Transcribed from screens/thrust-hiscore.png, where the text is known, by
# extracting each distinct cell bitmap and mapping it to the letter it draws;
# the mapping is verified by reading the whole screen back. Covers the letters,
# digits and stop the high-score table uses -- not the whole alphabet, and not
# the yellow HUD font, which this screen does not exercise.
#
# codepoint, then one byte per row (8 rows; only the top 5 carry ink).

0x002E 0x00 0x00 0x00 0x30 0x30 0x00 0x00 0x00  # '.'
0x0030 0xFE 0xC6 0xC6 0xDE 0xFE 0x00 0x00 0x00  # '0'
0x0031 0x78 0x18 0x18 0x7E 0x7E 0x00 0x00 0x00  # '1'
0x0032 0x7E 0x06 0xFE 0xE0 0xFE 0x00 0x00 0x00  # '2'
0x0033 0x78 0x18 0x7E 0x1E 0xFE 0x00 0x00 0x00  # '3'
0x0034 0xC0 0xCE 0xFE 0x0E 0x0E 0x00 0x00 0x00  # '4'
0x0035 0xF8 0xC0 0xFE 0x0E 0xFE 0x00 0x00 0x00  # '5'
0x0036 0xF0 0xC0 0xFE 0xCE 0xFE 0x00 0x00 0x00  # '6'
0x0037 0xFE 0x06 0x7E 0x70 0x70 0x00 0x00 0x00  # '7'
0x0038 0x7C 0x6C 0xFE 0xEE 0xFE 0x00 0x00 0x00  # '8'
0x0041 0x1E 0x36 0x66 0xFE 0xC6 0x00 0x00 0x00  # 'A'
0x0042 0xFC 0xCC 0xFE 0xC6 0xFE 0x00 0x00 0x00  # 'B'
0x0043 0xFE 0xC6 0xC0 0xC0 0xFE 0x00 0x00 0x00  # 'C'
0x0044 0xFE 0xC6 0xC6 0xCC 0xF8 0x00 0x00 0x00  # 'D'
0x0045 0xFE 0xC0 0xF8 0xC0 0xFE 0x00 0x00 0x00  # 'E'
0x0047 0xF8 0xC0 0xDE 0xC6 0xFE 0x00 0x00 0x00  # 'G'
0x0048 0xC6 0xC6 0xFE 0xC6 0xC6 0x00 0x00 0x00  # 'H'
0x0049 0x7E 0x18 0x18 0x18 0x7E 0x00 0x00 0x00  # 'I'
0x004C 0xC0 0xC0 0xC0 0xC0 0xFE 0x00 0x00 0x00  # 'L'
0x004D 0xFE 0xD6 0xD6 0xD6 0xC6 0x00 0x00 0x00  # 'M'
0x004E 0xF6 0xD6 0xD6 0xD6 0xDE 0x00 0x00 0x00  # 'N'
0x004F 0xFE 0xC6 0xC6 0xC6 0xFE 0x00 0x00 0x00  # 'O'
0x0050 0xFE 0xC6 0xC6 0xFE 0xC0 0x00 0x00 0x00  # 'P'
0x0052 0xFE 0xC6 0xFE 0xCC 0xC6 0x00 0x00 0x00  # 'R'
0x0053 0xFE 0xC0 0xFE 0x06 0xFE 0x00 0x00 0x00  # 'S'
0x0054 0xFE 0x30 0x30 0x30 0x30 0x00 0x00 0x00  # 'T'
0x0055 0xC6 0xC6 0xC6 0xC6 0xFE 0x00 0x00 0x00  # 'U'
0x0056 0xC6 0xC6 0xCC 0xD8 0xF0 0x00 0x00 0x00  # 'V'

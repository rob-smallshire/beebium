{
    "name": "scsi-hard-disc",
    "display_name": "SCSI Hard Disc",
    "description": "A SCSI hard disc, kept in a pair of image files (.dat and .dsc).",
    "library": "scsi-hard-disc",
    "attaches_to": [
        "scsi"
    ],
    "cli": "scsi-hdd",
    "parameters": [
        {
            "key": "scsi-id",
            "label": "SCSI ID",
            "type": "integer",
            "position": 0,
            "default": "0",
            "unique": true,
            "description": "SCSI target ID (0-7)",
            "min": 0,
            "max": 7
        },
        {
            "key": "image",
            "label": "Disc image",
            "type": "filepath",
            "position": 1,
            "required": true,
            "media": "hard-disc",
            "description": "Path to DAT disc image file"
        },
        {
            "key": "adapter-id",
            "label": "SCSI adapter",
            "type": "string",
            "provider_of": "scsi",
            "description": "ID of SCSI adapter to attach to"
        }
    ]
}

{
    "name": "scsi-hard-disc",
    "display_name": "SCSI Hard Disc",
    "description": "SCSI hard disc target (DAT+DSC image)",
    "library": "scsi-hard-disc",
    "attaches_to": ["scsi"],
    "cli": "scsi-hdd",
    "parameters": [
        {
            "key": "scsi-id",
            "type": "integer",
            "position": 0,
            "default": "0",
            "unique": true,
            "description": "SCSI target ID (0-7)"
        },
        {
            "key": "image",
            "type": "filepath",
            "position": 1,
            "description": "Path to DAT disc image file"
        },
        {
            "key": "adapter-id",
            "type": "string",
            "provider_of": "scsi",
            "description": "ID of SCSI adapter to attach to"
        }
    ]
}

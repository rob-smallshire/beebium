  "cases": [
    {
      "name": "1: no modifiers, no exact match: the first entry without `with`",
      "mapping": "rules",
      "event": {
        "code": "KeyZ",
        "text": "z"
      },
      "expect": {
        "key": "A",
        "ik": 65,
        "shift": false,
        "ctrl": false
      }
    },
    {
      "name": "1: an entry whose `with` equals the held modifiers wins",
      "mapping": "rules",
      "event": {
        "code": "KeyZ",
        "modifiers": [
          "Shift"
        ],
        "text": "Z"
      },
      "expect": {
        "key": "B",
        "ik": 100,
        "shift": false,
        "ctrl": false
      }
    },
    {
      "name": "1: exact match on two modifiers",
      "mapping": "rules",
      "event": {
        "code": "KeyZ",
        "modifiers": [
          "Shift",
          "Control"
        ],
        "text": "z"
      },
      "expect": {
        "key": "C",
        "ik": 82,
        "shift": false,
        "ctrl": false
      }
    },
    {
      "name": "1: no exact match: the first proper subset in file order, not the largest",
      "mapping": "rules",
      "event": {
        "code": "KeyZ",
        "modifiers": [
          "Shift",
          "Control",
          "Alt"
        ],
        "text": "z"
      },
      "expect": {
        "key": "B",
        "ik": 100,
        "shift": false,
        "ctrl": false
      }
    },
    {
      "name": "1: an entry needing Shift does not match without Shift",
      "mapping": "rules",
      "event": {
        "code": "KeyZ",
        "modifiers": [
          "Control"
        ],
        "text": "z"
      },
      "expect": {
        "key": "A",
        "ik": 65,
        "shift": false,
        "ctrl": false
      }
    },
    {
      "name": "1: a proper subset other than the first entries",
      "mapping": "rules",
      "event": {
        "code": "KeyZ",
        "modifiers": [
          "Alt",
          "Meta"
        ],
        "text": "z"
      },
      "expect": {
        "key": "D",
        "ik": 50,
        "shift": false,
        "ctrl": false
      }
    },
    {
      "name": "1: a disabled entry switched off is skipped; character mapping applies",
      "mapping": "rules",
      "event": {
        "code": "KeyW",
        "text": "w"
      },
      "expect": {
        "key": "w",
        "ik": 33,
        "shift": false,
        "ctrl": false
      }
    },
    {
      "name": "1: a disabled entry switched on applies",
      "mapping": "rules",
      "event": {
        "code": "KeyE",
        "text": "e"
      },
      "expect": {
        "key": "Y",
        "ik": 68,
        "shift": false,
        "ctrl": false
      }
    },
    {
      "name": "1: an entry's shift is held with the key",
      "mapping": "rules",
      "event": {
        "code": "Digit8",
        "modifiers": [
          "Shift"
        ],
        "text": "*"
      },
      "expect": {
        "key": ":",
        "ik": 72,
        "shift": true,
        "ctrl": false
      }
    },
    {
      "name": "1: without its `with` the entry does not apply; the character does",
      "mapping": "rules",
      "event": {
        "code": "Digit8",
        "text": "8"
      },
      "expect": {
        "key": "8",
        "ik": 21,
        "shift": false,
        "ctrl": false
      }
    },
    {
      "name": "1: an entry's ctrl is held with the key",
      "mapping": "rules",
      "event": {
        "code": "KeyC",
        "text": "c"
      },
      "expect": {
        "key": "C",
        "ik": 82,
        "shift": false,
        "ctrl": true
      }
    },
    {
      "name": "1: Break goes to the break line",
      "mapping": "rules",
      "event": {
        "code": "F12",
        "modifiers": [
          "Alt"
        ]

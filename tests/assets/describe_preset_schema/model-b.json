{
  "schema_version": 2,
  "model": {
    "id": "model-b",
    "name": "BBC Model B",
    "description": "The original BBC Microcomputer with 32KB RAM"
  },
  "sections": [
    {
      "type": "speed",
      "default": 1.0,
      "unlimited": "unlimited",
      "description": "Emulation speed as a positive multiple of real time, or \"unlimited\" to run flat out"
    },
    {
      "type": "startup",
      "screen_mode": {
        "min": 0,
        "max": 7,
        "default": 7
      },
      "auto_boot": {
        "default": false
      },
      "links": {
        "min": 0,
        "max": 255,
        "excludes": [
          "screen_mode",
          "auto_boot"
        ]
      },
      "description": "The startup keyboard links: screen_mode and auto_boot, or the whole links byte"
    },
    {
      "type": "mos_image_uri",
      "default": "acorn-mos_1_20.rom",
      "description": "The MOS ROM: a ROM name (found on the ROM search path) or a path"
    },
    {
      "type": "storage",
      "builtin": {
        "cassette": true,
        "fdc": null
      },
      "fdc_socket": {
        "options": [
          {
            "id": "none",
            "label": "Empty",
            "device": null,
            "description": "No disc controller"
          },
          {
            "id": "acorn-1770",
            "label": "Acorn 1770",
            "device": "WD1770",
            "description": "Standard Acorn disc controller upgrade for BBC Model B"
          }
        ]
      },
      "floppy_drives": [
        {
          "drive": 0,
          "tracks": [
            40,
            80
          ],
          "sides": 2,
          "image_types": [
            "ssd",
            "dsd",
            "adf",
            "adl",
            "adm",
            "ads",
            "hfe"
          ]
        },
        {
          "drive": 1,
          "tracks": [
            40,
            80
          ],
          "sides": 2,
          "image_types": [
            "ssd",
            "dsd",
            "adf",
            "adl",
            "adm",
            "ads",
            "hfe"
          ]
        }
      ]
    },
    {
      "type": "econet",
      "station": {
        "min": 1,
        "max": 254,
        "auto": true,
        "auto_default_range": [
          1,
          253
        ]
      },
      "transports": [
        "aun",
        "piconet"
      ]
    },
    {
      "type": "sideways_bank",
      "has_aliasing": true,
      "sockets": [
        {
          "label": "IC52",
          "slots": [
            0,
            4,
            8,
            12
          ],
          "capabilities": [
            "rom",
            "ram",
            "empty"
          ],
          "runtime_configurable": false
        },
        {
          "label": "IC88",
          "slots": [
            1,
            5,
            9,
            13
          ],
          "capabilities": [
            "rom",
            "ram",
            "empty"
          ],
          "runtime_configurable": false
        },
        {
          "label": "IC100",
          "slots": [
            2,
            6,
            10,
            14
          ],
          "capabilities": [
            "rom",
            "ram",
            "empty"
          ],
          "runtime_configurable": false
        },
        {
          "label": "IC101",
          "slots": [
            3,
            7,
            11,
            15
          ],
          "capabilities": [
            "rom",
            "ram",
            "empty"
          ],
          "runtime_configurable": false
        }
      ],
      "default_roms": [
        {
          "slot": 15,
          "image": "bbc-basic_2.rom",
          "role": "language"
        }
      ]
    },
    {
      "type": "extensions",
      "attachment_points": [
        {
          "id": "1mhz-bus",
          "display_name": "1 MHz Bus",
          "min_occupancy": 0,
          "max_occupancy": null,
          "provided_by": null,
          "extensions": [
            "test-scratch-ram",
            "acorn-scsi"
          ]
        },
        {
          "id": "user-port",
          "display_name": "User Port",
          "min_occupancy": 0,
          "max_occupancy": 1,
          "provided_by": null,
          "extensions": [
            "acorn-rtc"
          ]
        },
        {
          "id": "tube",
          "display_name": "Tube",
          "min_occupancy": 0,
          "max_occupancy": 1,
          "provided_by": null,
          "extensions": [
            "acorn-65c102-coprocessor",
            "acorn-65c02-coprocessor"
          ]
        },
        {
          "id": "serial-port",
          "display_name": "Serial Port",
          "min_occupancy": 0,
          "max_occupancy": 1,
          "provided_by": null,
          "extensions": [
            "host-serial",
            "rpc-serial",
            "rfc2217-client-serial",
            "ip232-serial",
            "loopback-serial",
            "rfc2217-server-serial"
          ]
        },
        {
          "id": "scsi",
          "display_name": "SCSI Bus",
          "min_occupancy": 0,
          "max_occupancy": 7,
          "provided_by": [
            "acorn-scsi"
          ],
          "extensions": [
            "scsi-hard-disc"
          ]
        }
      ],
      "bundled_images": {
        "hard-disc": [
          {
            "image": "l3fs-v1_26b.dat",
            "size_bytes": 10002432,
            "extension": null
          }
        ],
        "rom": [
          {
            "image": "acorn-tube-65c102_1_20.rom",
            "size_bytes": 4096,
            "extension": "acorn-65c102-coprocessor"
          },
          {
            "image": "acorn-tube-6502_1_10.rom",
            "size_bytes": 4096,
            "extension": "acorn-65c02-coprocessor"
          }
        ]
      }
    }
  ]
}

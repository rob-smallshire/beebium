{
  "name": "@beebium/client",
  "version": "0.1.7",
  "description": "TypeScript client for the Beebium BBC Micro emulator",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rob-smallshire/beebium.git",
    "directory": "clients/beebium-typescript-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/*integration*'",
    "test:integration": "vitest run tests/*integration*",
    "test:watch": "vitest",
    "generate-protos": "bash scripts/generate-protos.sh"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "long": "^5.3.2",
    "protobufjs": "^7.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-proto": "^1.176.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src"
  ]
}

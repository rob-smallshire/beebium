#!/bin/bash
#
# Pre-commit hook to verify copyright and licence notices are present in source
# files, and to keep the maintainer's copyright year current.
#
# Checks staged .swift, .h, .c, .hpp, .cpp, .py files. A file passes when:
#   - it carries one of the accepted licence notices (KNOWN_NOTICES below): the
#     Beebium notice, or the notice of a plugin contributed with its own name;
#   - and at least one of its copyright lines names a known contributor
#     (KNOWN_CONTRIBUTORS below). Any of them will do; none is required.
# A copyright line may read "Copyright YYYY Name", "Copyright © YYYY Name",
# "Copyright (C) YYYY Name" or "Copyright (c) YYYY Name", with a single year or
# a range "YYYY-YYYY", and an email or not.
#
# The year is updated only on the maintainer's (Robert Smallshire's) own line,
# and only when it is a single year. Another contributor's line is their claim:
# the hook never rewrites it.

# The people who hold copyright in Beebium's files. A new contributor is added
# here, by name, as a deliberate and reviewable change.
KNOWN_CONTRIBUTORS=(
    "Robert Smallshire"
    "Mark J. Fisher"
    "James Sargent"
    "Tom Seddon"
)

# The licence notices a file may carry, either or both.
KNOWN_NOTICES=(
    "This file is part of Beebium"
    "This file is part of AESulator, a plugin for Beebium"
)

MAINTAINER="Robert Smallshire"

# Get current year
current_year=$(date +%Y)

# Get list of staged files (excluding deleted files)
staged_files=$(git diff --cached --name-only --diff-filter=d)

# The text of a name, escaped for an extended regular expression.
regex_escape() {
    printf '%s' "$1" | sed 's/[][\.*^$()+?{}|]/\\&/g'
}

# The start of a copyright line, up to and including the year or range and the
# space before the holder's name.
copyright_prefix='Copyright( ©| \([Cc]\))? [0-9]{4}(-[0-9]{4})?,? (by )?'

has_known_notice() {
    local notice
    for notice in "${KNOWN_NOTICES[@]}"; do
        if grep -qF "$notice" "$1" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

has_known_contributor() {
    local name
    for name in "${KNOWN_CONTRIBUTORS[@]}"; do
        if grep -qE "${copyright_prefix}$(regex_escape "$name")" "$1" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

# Track files missing an accepted licence notice
missing_copyright=()

# Track files that have a notice but no known contributor as holder
missing_contributor=()

# Track files with updated year
updated_year=()

maintainer_pattern=$(regex_escape "$MAINTAINER")

for file in $staged_files; do
    # Check file extension
    case "$file" in
        *.swift|*.h|*.c|*.hpp|*.cpp|*.py)
            # Skip generated protobuf files
            if [[ "$file" == *"/Generated/"* ]]; then
                continue
            fi

            # Skip third-party libraries (they have their own licenses)
            if [[ "$file" == "third_party/"* || "$file" == *"/third_party/"* ]]; then
                continue
            fi

            # Skip example scripts (short demos, not core project code)
            if [[ "$file" == *"/examples/"* ]]; then
                continue
            fi

            if ! has_known_notice "$file"; then
                missing_copyright+=("$file")
            elif ! has_known_contributor "$file"; then
                missing_contributor+=("$file")
            else
                # The maintainer's own line, with a single year, in any of
                # the forms "Copyright © YYYY", "Copyright (C) YYYY" and
                # "Copyright YYYY". Only that line's year is read and updated.
                maintainer_line=$(grep -E "Copyright( ©| \(C\))? [0-9]{4} ${maintainer_pattern}" "$file" 2>/dev/null | head -1)
                if [ -n "$maintainer_line" ]; then
                    file_year=$(printf '%s' "$maintainer_line" | grep -oE "Copyright( ©| \(C\))? [0-9]{4}" | grep -oE "[0-9]{4}")

                    if [ -n "$file_year" ] && [ "$file_year" != "$current_year" ]; then
                        # Each substitution names the maintainer, so no other
                        # holder's line can match it.
                        sed -i '' "s/Copyright © $file_year $MAINTAINER/Copyright © $current_year $MAINTAINER/g" "$file"
                        sed -i '' "s/Copyright (C) $file_year $MAINTAINER/Copyright © $current_year $MAINTAINER/g" "$file"
                        sed -i '' "s/Copyright $file_year $MAINTAINER/Copyright $current_year $MAINTAINER/g" "$file"

                        # Re-stage the file with updated year
                        git add "$file"
                        updated_year+=("$file")
                    fi
                fi
            fi
            ;;
    esac
done

# Report files with updated copyright year
if [ ${#updated_year[@]} -ne 0 ]; then
    echo "Updated copyright year to $current_year in:"
    for file in "${updated_year[@]}"; do
        echo "  $file"
    done
    echo ""
fi

# Report and fail if any files have a notice but no known contributor
if [ ${#missing_contributor[@]} -ne 0 ]; then
    echo "ERROR: The following files have a licence notice but no copyright line"
    echo "naming a known contributor:"
    echo ""
    for file in "${missing_contributor[@]}"; do
        echo "  $file"
    done
    echo ""
    echo "The known contributors are:"
    for name in "${KNOWN_CONTRIBUTORS[@]}"; do
        echo "  $name"
    done
    echo ""
    echo "Name one of them in a copyright line, for example:"
    echo "  // Copyright $current_year Robert Smallshire <robert@smallshire.org.uk>"
    echo "If the holder is a new contributor, add their name to KNOWN_CONTRIBUTORS"
    echo "at the top of scripts/pre-commit, then run scripts/install-hooks."
    echo ""
    exit 1
fi

# Report and fail if any files are missing a notice
if [ ${#missing_copyright[@]} -ne 0 ]; then
    echo "ERROR: The following files are missing a licence notice:"
    echo ""
    for file in "${missing_copyright[@]}"; do
        echo "  $file"
    done
    echo ""
    echo "Accepted notices (either or both):"
    for notice in "${KNOWN_NOTICES[@]}"; do
        echo "  $notice"
    done
    echo ""
    echo "Please add the Beebium notice at the top of each file:"
    echo ""
    echo "For C/C++/Swift:"
    echo "  // Copyright © $current_year Robert Smallshire <robert@smallshire.org.uk>"
    echo "  //"
    echo "  // This file is part of Beebium."
    echo "  //"
    echo "  // Beebium is free software: you can redistribute it and/or modify it under the terms of the"
    echo "  // GNU General Public License as published by the Free Software Foundation, either version 3 of the"
    echo "  // License, or (at your option) any later version. Beebium is distributed in the hope that it will"
    echo "  // be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or"
    echo "  // FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details."
    echo "  // You should have received a copy of the GNU General Public License along with Beebium."
    echo "  // If not, see <https://www.gnu.org/licenses/>."
    echo ""
    echo "For Python:"
    echo "  # Copyright $current_year Robert Smallshire <robert@smallshire.org.uk>"
    echo "  #"
    echo "  # This file is part of Beebium."
    echo "  #"
    echo "  # Beebium is free software: you can redistribute it and/or modify it under the terms of the"
    echo "  # GNU General Public License as published by the Free Software Foundation, either version 3 of the"
    echo "  # License, or (at your option) any later version. Beebium is distributed in the hope that it will"
    echo "  # be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or"
    echo "  # FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details."
    echo "  # You should have received a copy of the GNU General Public License along with Beebium."
    echo "  # If not, see <https://www.gnu.org/licenses/>."
    echo ""
    exit 1
fi

exit 0
